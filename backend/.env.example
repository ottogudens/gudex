APP_NAME=Lubricentro API
APP_ENV=development
SEED_DEFAULT_USERS=true
DEFAULT_ADMIN_EMAIL=admin@lubricentro.local
DEFAULT_MECHANIC_EMAIL=mecanico@lubricentro.local
DEFAULT_CUSTOMER_EMAIL=cliente@lubricentro.local
DATABASE_URL=sqlite:///./lubricentro.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=15000000
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:8000,http://localhost:5000
MERCADOPAGO_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_FRONTEND_REDIRECT_URL=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CALENDAR_ID=primary
GOOGLE_GMAIL_QUERY=has:attachment filename:pdf newer_than:30d
INTEGRATION_ENCRYPTION_KEY=
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=gpt-5-mini
AI_BASE_URL=https://api.openai.com/v1
AI_MAX_OUTPUT_TOKENS=900
AI_AUDIT_RETENTION_DAYS=90
